# FundReady backend - environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` or any real secret.
# Every key this service reads must be listed here, with an empty value.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_BASE_URL=
CORS_ALLOWED_ORIGINS=        # comma-separated; restrict to known origins

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Least-privilege application role. Migrations may use a separate, higher role.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (Auth + Storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses row-level security. Never ship this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification (AUTH.md section 3).
# OPEN ITEM: confirm which signing method this Supabase project uses before
# T0.4, then set exactly one of the two below.
#   - asymmetric keys -> set SUPABASE_JWKS_URL
#   - shared secret   -> set SUPABASE_JWT_SECRET
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Object storage (documents + evidence)
# ---------------------------------------------------------------------------
STORAGE_BUCKET_DOCUMENTS=
STORAGE_BUCKET_EVIDENCE=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Queue (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=
QUEUE_NAME=fundready

# ---------------------------------------------------------------------------
# AI (Claude API) - model tiering and budgets per DECISIONS.md D16
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL_AUDIT=              # strongest model: audits, scoring, evidence
AI_MODEL_CHAT=               # cheaper model: founder + investor chat
AI_MAX_OUTPUT_TOKENS=
AI_DAILY_BUDGET_TOKENS_PER_USER=

# ---------------------------------------------------------------------------
# Stripe (billed through the UK/US entity; no Connect in v1 - DECISIONS.md D5)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # required; webhook signatures are always verified
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Email (transactional)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=
