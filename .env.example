# FundReady backend - environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` or any real secret.
# Every key this service reads must be listed here, with an empty value.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_BASE_URL=
CORS_ALLOWED_ORIGINS=        # comma-separated; restrict to known origins

# ---------------------------------------------------------------------------
# Database (Neon: serverless Postgres + pgvector)
# ---------------------------------------------------------------------------
# Least-privilege application role. Migrations may use a separate, higher role.
# The plain postgresql:// form is fine; the async driver is applied for you.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (self-built -- AUTH.md)
# ---------------------------------------------------------------------------
# Signs our access tokens. At least 32 characters; a short secret makes every
# token forgeable offline. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_KEY_ID=k1              # bump when rotating the signing key
JWT_ISSUER=fundready
JWT_AUDIENCE=fundready-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id cost. Memory cost is real RAM per concurrent login -- on a small
# instance, lower it rather than running out. Production floors: 19456 / 2.
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Encrypts TOTP secrets at rest, so a database leak does not defeat MFA.
MFA_SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 -- documents + evidence, never in Postgres)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=           # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCUMENTS=
R2_BUCKET_EVIDENCE=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Queue (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=
QUEUE_NAME=fundready

# ---------------------------------------------------------------------------
# AI (Claude API) - model tiering and budgets per DECISIONS.md D16
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL_AUDIT=              # strongest model: audits, scoring, evidence
AI_MODEL_CHAT=               # cheaper model: founder + investor chat
AI_MAX_OUTPUT_TOKENS=
AI_DAILY_BUDGET_TOKENS_PER_USER=

# ---------------------------------------------------------------------------
# Stripe (billed through the UK/US entity; no Connect in v1 - DECISIONS.md D5)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # required; webhook signatures are always verified
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Email (transactional)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=
