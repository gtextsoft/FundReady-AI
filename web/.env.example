# Upstream FastAPI. Used by server routes and the /v1 rewrite — not by the browser.
# Local:
API_URL=http://localhost:8000
#
# Production default (also in .env.production) is the Render service:
# API_URL=https://fundready-ai.onrender.com
#
# NEXT_PUBLIC_API_URL is accepted as a fallback for API_URL so existing
# .env.local files keep working. Prefer API_URL — it is not inlined into the bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000
