# Expo reads EXPO_PUBLIC_* at bundle time and inlines them into the client.
# Only ever put non-secret values here -- anything in this file ships to the
# device and is readable by anyone who has the app.

# Where the FundReady API lives. Defaults to http://localhost:8000 when unset.
# On a physical phone, use your machine's LAN address (e.g. http://192.168.1.20:8000)
# and add that origin to CORS_ALLOWED_ORIGINS in the backend's .env.
EXPO_PUBLIC_API_URL=http://localhost:8000
