# Expo reads EXPO_PUBLIC_* at bundle time and inlines them into the client.
# Only ever put non-secret values here -- anything in this file ships to the
# device and is readable by anyone who has the app.

# Where the FundReady API lives.
#
# The deployed staging service:
EXPO_PUBLIC_API_URL=https://fundready-ai.onrender.com
#
# Leave it unset instead to develop against a backend on this machine. With no
# value the app takes the host from whatever address served the bundle and
# talks to port 8000 on it, so Expo Go on a phone reaches this machine without
# the LAN address being baked in. Add that origin to CORS_ALLOWED_ORIGINS in
# the backend's .env.
#
# NOTE: the deployed service currently allows NO browser origins, so the web
# preview cannot reach it -- use a device for staging. See TASKS.md.
