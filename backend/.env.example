# FundReady backend - environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` or any real secret.
# Every key this service reads must be listed here, with an empty value.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_BASE_URL=
# Base URL for links sent by email, e.g. https://app.fundready.com. The mobile
# client owns these as deep links and POSTs the token back -- email security
# scanners prefetch URLs, which would burn a single-use token before use.
APP_LINK_BASE_URL=
# Comma-separated; restrict to known origins.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Database (Neon: serverless Postgres + pgvector)
# ---------------------------------------------------------------------------
# Least-privilege application role. Migrations may use a separate, higher role.
# The plain postgresql:// form is fine; the async driver is applied for you.
# Use Neon's POOLED endpoint here (the host containing "-pooler").
DATABASE_URL=

# Optional. Neon's DIRECT endpoint -- the same host without "-pooler". Alembic
# uses it for DDL, because the pooled endpoint is PgBouncer in transaction mode
# and is not the recommended target for schema changes. Falls back to
# DATABASE_URL when left blank.
DATABASE_MIGRATION_URL=

# Test-only, never read by the running service. Point it at a throwaway
# database -- a Neon branch is ideal -- and the suite will use it instead of
# DATABASE_URL. Database tests roll back everything they write either way.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (self-built -- AUTH.md)
# ---------------------------------------------------------------------------
# Signs our access tokens. At least 32 characters; a short secret makes every
# token forgeable offline. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_KEY_ID=k1              # bump when rotating the signing key
JWT_ISSUER=fundready
JWT_AUDIENCE=fundready-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id cost. Memory cost is real RAM per concurrent login -- on a small
# instance, lower it rather than running out. Production floors: 19456 / 2.
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Encrypts TOTP secrets at rest, so a database leak does not defeat MFA.
MFA_SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 -- documents + evidence, never in Postgres)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCUMENTS=
R2_BUCKET_EVIDENCE=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Queue (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=
QUEUE_NAME=fundready

# ---------------------------------------------------------------------------
# AI (Claude API) - model tiering and budgets per DECISIONS.md D16
# ---------------------------------------------------------------------------
#
# The two model ids are overrides. Leave them blank to use the tier defaults
# chosen in T2.1 and recorded in `app/ai/client.py` -- audits on claude-opus-5,
# chat on claude-sonnet-5. Set one only to pin a different model per
# environment; the choice itself lives in code, next to the tiering logic.
ANTHROPIC_API_KEY=
# Override: strongest model - audits, scoring, evidence. Blank uses the code
# default, `claude-opus-5`.
AI_MODEL_AUDIT=
# Override: cheaper model - founder + investor chat. Blank uses the code
# default, `claude-sonnet-5`.
AI_MODEL_CHAT=
# A ceiling on output tokens, not a value: each tier requests its own budget
# under it (16k audit / 4k chat). Blank means the tier defaults apply as-is.
AI_MAX_OUTPUT_TOKENS=
# Measured from day one, enforced in T5.5. `ai.client` records per-user token
# usage on every call; nothing reads this budget yet.
AI_DAILY_BUDGET_TOKENS_PER_USER=

# ---------------------------------------------------------------------------
# Stripe (billed through the UK/US entity; no Connect in v1 - DECISIONS.md D5)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Required; webhook signatures are always verified.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Email (transactional)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=